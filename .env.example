# EVE Online Developer Portal credentials
# Copy to .env and fill in your actual values
# NEVER commit .env to git

EVE_CLIENT_ID=your_client_id_here
EVE_CLIENT_SECRET=your_client_secret_here
EVE_CALLBACK_URL=http://localhost:5001/callback

# Ollama settings (defaults fine for local Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Database path (relative to mordu_server.py)
DB_PATH=mordu.db
