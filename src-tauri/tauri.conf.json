{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Mordu Market Engine",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": false,
        "sidecar": true,
        "open": false,
        "scope": [{"name": "mordu_server", "sidecar": true}]
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:5000/*", "http://localhost:5001/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.mordu.market-engine",
      "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
      "externalBin": ["bin/mordu_server"],
      "resources": []
    },
    "security": {"csp": null},
    "updater": {"active": false},
    "windows": [{
      "fullscreen": false,
      "resizable": true,
      "title": "Mordu Market Engine",
      "width": 1400,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "decorations": true,
      "transparent": false
    }]
  }
}
